
; Dependency file for setup wizards.

[Version]
Version=7.0.0.07

; Dependencies for FPSPR70.OCX

; Default Dependencies ----------------------------------------------

[FPSPR70.OCX]
Dest=$(WinSysPath)
Register=$(DLLSelfRegister)
Version=7.0.0.07
Uses1=mfc42.dll
Uses2=msvcrt.dll

[mfc42.dll]
Dest=$(WinSysPathSysFile)
Register=$(DLLSelfRegister)
Uses1=

[msvcrt.dll]
Dest=$(WinSysPathSysFile)
Uses1=
